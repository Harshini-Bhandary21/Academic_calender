# Copy this file to .env and fill in real values -- .env is gitignored,
# this file is not (it holds no secrets, only placeholders/instructions).

# MongoDB Atlas connection string -- get this from your cluster's "Connect"
# button in the Atlas dashboard. Without it, the API still runs but
# persistence is silently skipped (a warning is logged instead).
MONGODB_URI=
MONGODB_DB_NAME=academic_calendar

# Comma-separated list of origins allowed to call this API -- the Vite dev
# server(s) locally, your real Vercel URL in production. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# The one shared password that grants edit access to the calendar -- change
# this to a real value, never commit a real one.
ADMIN_PASSWORD=changeme123

# Secret used to sign admin session JWTs -- generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme
